{
  "name": "@yourorg/chatbot-widget",
  "version": "0.1.0",
  "description": "A premium, embeddable AI chat widget that talks to an n8n webhook. Ships as a React component or a single <script> tag.",
  "type": "module",
  "license": "MIT",
  "main": "dist/chatbot-widget.cjs.js",
  "module": "dist/chatbot-widget.es.js",
  "exports": {
    ".": {
      "import": "./dist/chatbot-widget.es.js",
      "require": "./dist/chatbot-widget.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:package": "vite build --config vite.package.config.js",
    "build:embed": "vite build --config vite.embed.config.js",
    "build:all": "npm run build:package && npm run build:embed"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  }
}
